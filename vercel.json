{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{dist/**,index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/|fonts/|favicon|apple-touch-icon|site\\.webmanifest|logo|sitemap|robots|.*\\.(?:js|css|png|jpg|jpeg|gif|svg|ico|json|xml|txt|map|woff|woff2|ttf|eot)$).*)",
      "destination": "/api"
    }
  ]
}
